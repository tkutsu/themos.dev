---
interface Props { title?: string; }
const { title = 'themos.dev' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Web developer crafting fast, elegant digital experiences." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Outfit:wght@400;600&display=swap" rel="stylesheet" />
    <title>{title}</title>
    <script is:inline>
      (function(){
        var s = localStorage.getItem('theme');
        if (s === 'dark' || (!s && matchMedia('(prefers-color-scheme: dark)').matches))
          document.documentElement.classList.add('dark');
      })();
    </script>
  </head>
  <body class="bg-page text-primary font-mono antialiased transition-colors duration-300">
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --bg: #fafafa;
    --text: #1a1a1a;
    --dim: #999;
    --border: #e0e0e0;
    --cursor: #1a1a1a;
    --card-bg: #fff;
  }
  html.dark {
    --bg: #111;
    --text: #d4d4d4;
    --dim: #555;
    --border: #252525;
    --cursor: #d4d4d4;
    --card-bg: #1a1a1a;
  }
  ::selection { background: var(--text); color: var(--bg); }
</style>
