---
import Base from '../layouts/Base.astro';

const links = [
  { label: 'github', href: 'https://github.com/tkutsu' },
  { label: 'linkedin', href: 'https://www.linkedin.com/in/themos-koutsouris-63b0a6395' },
  { label: 'email', href: 'mailto:me@themos.dev' },
];
---

<Base>
  <!-- Theme toggle -->
  <button
    id="toggle"
    class="fixed top-5 right-5 w-[30px] h-[30px] flex items-center justify-center border border-line rounded-md bg-transparent text-dim text-[13px] cursor-pointer transition-colors duration-200 hover:border-dim hover:text-primary"
    aria-label="Toggle theme"
    >
    <svg class="hidden dark:block" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
    <svg class="block dark:hidden" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
  </button>

  <main class="min-h-dvh flex items-center justify-center px-4 py-16">
    <div class="w-full max-w-[480px] sm:aspect-[1.75/1] sm:bg-card sm:shadow-card sm:rounded-md sm:px-10 sm:py-12 px-6 flex flex-col justify-between">

      <!-- Console typing line -->
      <div class="flex items-center text-[0.9375rem] leading-normal min-h-[1.5em]">
        <span class="text-dim mr-2 select-none">$</span>
        <span id="typed"></span>
        <span class="inline-block w-[0.55em] h-[1.15em] bg-cursor align-text-bottom ml-px animate-blink transition-colors duration-300"></span>
      </div>

      <!-- About -->
      <div class="section opacity-0 translate-y-1.5 transition-all duration-[400ms] ease-out" id="s-about">
        <p class="font-body text-[0.9375rem] leading-[1.75] opacity-80">
          I build things on the web.
        </p>
      </div>

      <!-- Connect -->
      <div class="section opacity-0 translate-y-1.5 transition-all duration-[400ms] ease-out" id="s-connect">
        <div class="flex gap-5 flex-wrap">
          {links.map((link) => (
            <a
              href={link.href}
              target={link.href.startsWith('mailto') ? undefined : '_blank'}
              rel={link.href.startsWith('mailto') ? undefined : 'noopener noreferrer'}
              class="text-[0.8125rem] text-dim no-underline transition-colors duration-200 hover:text-primary group"
            >
              {link.label}
              <span class="inline-block text-[0.7em] opacity-0 -translate-x-[3px] transition-all duration-200 group-hover:opacity-50 group-hover:translate-x-0">↗</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </main>
</Base>

<script>
  // Theme toggle
  document.getElementById('toggle')!.addEventListener('click', () => {
    document.documentElement.classList.toggle('dark');
    localStorage.setItem(
      'theme',
      document.documentElement.classList.contains('dark') ? 'dark' : 'light'
    );
  });

  // Block-cursor typer
  const text = 'themos.dev';
  const el = document.getElementById('typed')!;
  let i = 0;

  function type() {
    if (i < text.length) {
      el.textContent += text[i++];
      setTimeout(type, 80 + Math.random() * 50);
    } else {
      setTimeout(() => document.getElementById('s-about')!.classList.add('opacity-100', 'translate-y-0'), 250);
      setTimeout(() => document.getElementById('s-connect')!.classList.add('opacity-100', 'translate-y-0'), 500);
    }
  }

  setTimeout(type, 500);
</script>
