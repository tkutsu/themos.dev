---
import Base from '../layouts/Base.astro';

const tagline = 'A smörgåsbord of web apps and Linux tøøls.';

const sections = [
  {
    dir: 'tools',
    items: [
      {
        name: 'wayhint',
        href: 'https://github.com/tkutsu/wayhint',
        thumb: '/thumbs/wayhint.svg',
        desc: 'Keyboard-driven clicking for Hyprland: hint labels and text search',
      },
      {
        name: 'dewdrop',
        href: 'https://github.com/tkutsu/dewdrop',
        thumb: '/thumbs/dewdrop.svg',
        desc: 'Liquid glass shell for Hyprland: bar, launcher, notifications, music, timers, phone alarms, weather, feeds, mail, calendar, tasks etc',
      },
      {
        name: 'mousewand',
        href: 'https://github.com/tkutsu/mousewand',
        thumb: '/thumbs/mousewand.svg',
        desc: 'Mouse gestures for every Linux desktop: hold a button, draw a stroke, the window under it acts.',
      },
    ],
  },
  {
    dir: 'apps',
    items: [
      {
        name: 'My Pocket Bus: Athens',
        href: 'https://bus.themos.dev',
        thumb: '/thumbs/bus.svg',
        desc: 'Web app for nearby Athens bus stops and live arrivals.',
      },
      {
        name: 'Regimen',
        href: 'https://github.com/tkutsu/regimen',
        thumb: '/thumbs/regimen.svg',
        desc: 'Calorie and weigh-in tracker for Linux & Android, synced with Syncthing',
      },
    ],
  },
  {
    dir: 'srv',
    items: [
      {
        name: 'summit.gr',
        href: 'https://summit.gr',
        thumb: '/thumbs/summit.webp',
        desc: 'Team building and training company. Catalogue, semantic search, registrations and online payments, self-hosted on Docker Swarm.',
      },
      {
        name: 'old.summit.gr',
        href: 'https://old.summit.gr',
        thumb: '/thumbs/old-summit.webp',
        desc: 'The previous summit.gr, built to replace the original WordPress site. Still up.',
      },
      {
        name: 'partyquest.gr',
        href: 'https://partyquest.gr',
        thumb: '/thumbs/partyquest.webp',
        desc: "Adventure and quiz games for kids' parties, with a catalogue the staff update themselves.",
      },
    ],
  },
  {
    dir: 'games',
    items: [
      {
        name: 'Silhouetto',
        href: 'https://silhouetto.themos.dev',
        thumb: '/thumbs/silhouetto.webp',
        desc: 'Rotate a 3D shape until its shadow fits the outline on the wall. Endless generated puzzles, and every URL shares its exact shape.',
      },
      {
        name: 'Bloxorz',
        href: 'https://bloxorz.themos.dev',
        thumb: '/thumbs/bloxorz.webp',
        desc: 'Bloxorz in WebGL, with procedurally generated levels.',
      },
    ],
  },
  {
    dir: 'datavis',
    items: [
      {
        name: 'EU beaches',
        href: 'https://beaches.themos.dev',
        thumb: '/thumbs/beaches.svg',
        desc: 'Finding the perfect beach among 26,199 bathing waters rated back to 1990, with sea temperature, waves and amenities for each.',
      },
      {
        name: 'EU bird radar',
        href: 'https://birds.themos.dev',
        thumb: '/thumbs/birds.svg',
        desc: 'The flight paths of birds migrating over Europe at night, drawn from weather radar. Fun to watch.',
      },
      {
        name: 'GR wildfires',
        href: 'https://wildfires.themos.dev',
        thumb: '/thumbs/wildfires.svg',
        desc: 'A live map of fires in Greece: what is burning today, what the season has taken, and the fire danger for tomorrow.',
      },
    ],
  },
];

const links = [
    {
      label: 'Email',
      href: 'mailto:me@themos.dev',
      icon: '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>',
    },
    {
      label: 'GitHub',
      href: 'https://github.com/tkutsu',
      icon: '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/></svg>',
    },
    {
      label: 'LinkedIn',
      href: 'https://www.linkedin.com/in/themos-koutsouris-63b0a6395',
      icon: '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>',
    },
  ];
---

<Base>
  <!-- Theme toggle -->
  <button
    id="toggle"
    class="absolute sm:fixed top-5 right-5 z-20 w-[30px] h-[30px] flex items-center justify-center cursor-pointer text-dim transition-colors duration-200 hover:text-primary"
    aria-label="Toggle theme"
  >
    <svg class="hidden dark:block" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
    <svg class="block dark:hidden" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
  </button>

  <!-- Phones start at the top; from 640px up the card is centred in the window. -->
  <main class="min-h-dvh flex flex-col items-center sm:justify-center px-4 pt-16 pb-10 sm:py-16">
    <div id="card" class="w-full max-w-[440px] px-2 sm:px-6 sm:pt-7 sm:pb-3.5 sm:bg-card sm:rounded-[14px] sm:ring-1 sm:ring-line sm:shadow-card flex flex-col gap-6">

      <!-- console typing line, with the site description under it -->
      <header class="flex flex-col gap-1.5">
        <div class="flex items-center justify-between text-[0.9375rem] leading-normal min-h-[1.5em]">
          <h1 class="flex items-center">
            <span id="title">themos.dev</span>
            <span aria-hidden="true" class="inline-block w-[0.55em] h-[1.15em] bg-cursor align-text-bottom ml-px animate-blink transition-colors duration-300"></span>
          </h1>
          <nav aria-label="Contact" class="reveal flex -mr-2.5" style="--d: 0.5s">
            {links.map((link) => (
              <a
                href={link.href}
                target={link.href.startsWith('mailto') ? undefined : '_blank'}
                rel={link.href.startsWith('mailto') ? undefined : 'noopener noreferrer'}
                class="w-10 h-10 flex items-center justify-center text-dim transition-colors duration-200 hover:text-primary"
                aria-label={link.label}
              >
                <Fragment set:html={link.icon} />
              </a>
            ))}
          </nav>
        </div>
        <p class="reveal font-body text-[0.875rem] text-dim" style="--d: 0.3s">{tagline}</p>
      </header>

      <!-- projects, one tab per section -->
      <section class="reveal flex flex-col gap-1.5" style="--d: 0.4s">
        <div role="tablist" aria-label="Projects" class="relative grid grid-cols-5 border-b border-line">
          {sections.map((section, s) => (
            <button
              type="button"
              role="tab"
              id={`tab-${section.dir}`}
              aria-controls={`panel-${section.dir}`}
              aria-selected={s === 0 ? 'true' : 'false'}
              tabindex={s === 0 ? 0 : -1}
              class="h-11 rounded-md text-[0.75rem] text-dim cursor-pointer outline-none focus-visible:ring-1 focus-visible:ring-inset focus-visible:ring-dim transition-colors duration-200 hover:text-primary aria-selected:text-primary"
            >
              {section.dir}<sup class="ml-0.5 text-[0.5625rem] opacity-70 max-[359px]:hidden">{section.items.length}</sup>
            </button>
          ))}
          <span id="indicator" aria-hidden="true" class="absolute left-0 -bottom-px w-1/5 h-px bg-primary transition-transform duration-[400ms] ease-out-soft"></span>
        </div>

        <!-- Every panel sits in the same grid cell, so the card keeps the height of the tallest one and never jumps. -->
        <div class="panels grid -mx-3">
          {sections.map((section, s) => (
            <div
              role="tabpanel"
              id={`panel-${section.dir}`}
              aria-labelledby={`tab-${section.dir}`}
              class:list={['panel col-start-1 row-start-1 flex flex-col', s === 0 && 'on']}
            >
              {section.items.map((project, i) => (
                <a
                  href={project.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="row group flex gap-3.5 items-start p-3 rounded-lg hover:bg-page"
                  style={`--i: ${i}`}
                >
                  <span class="shrink-0 mt-0.5 w-14 h-[35px] overflow-hidden rounded ring-1 ring-line">
                    <img
                      src={project.thumb}
                      alt=""
                      width="56"
                      height="35"
                      loading={s === 0 ? 'eager' : 'lazy'}
                      decoding="async"
                      class="w-full h-full object-cover object-top saturate-[.55] opacity-90 transition duration-500 ease-out-soft group-hover:saturate-100 group-hover:opacity-100 group-hover:scale-105 dark:opacity-70 dark:group-hover:opacity-100"
                    />
                  </span>
                  <span class="flex min-w-0 flex-1 flex-col gap-1">
                    <span class="flex items-center gap-1.5 font-body text-[0.9375rem] font-medium">
                      {project.name}
                      <svg class="shrink-0 opacity-0 -translate-x-0.5 translate-y-0.5 transition duration-200 group-hover:opacity-100 group-hover:translate-x-0 group-hover:translate-y-0 text-dim" xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M7 7h10v10"/></svg>
                      <span class="ml-auto text-[0.65625rem] font-normal font-mono text-dim">{project.href.includes('github.com') ? 'source' : 'live'}</span>
                    </span>
                    <span class="font-body text-[0.84375rem] leading-normal text-dim [text-wrap:pretty]">{project.desc}</span>
                  </span>
                </a>
              ))}
            </div>
          ))}
        </div>
      </section>
    </div>
  </main>
</Base>

<style>
  /* The title is in the HTML for crawlers and no-JS visitors; with JS it stays hidden until the typer takes over. */
  :global(html.js) #title:not(.ready) {
    visibility: hidden;
  }

  .reveal {
    opacity: 0;
    transform: translateY(10px);
    transition:
      opacity 0.7s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: var(--d, 0s);
  }
  .revealed .reveal {
    opacity: 1;
    transform: none;
  }

  /* Only the open panel shows. Its rows rise in one after another: after the opening reveal on load, at once on a tab switch. */
  .panels {
    --d0: 0.55s;
  }
  .settled .panels {
    --d0: 0s;
  }
  .panel {
    visibility: hidden;
  }
  .panel.on {
    visibility: visible;
  }
  .row {
    opacity: 0;
    transform: translateY(4px);
    transition: background-color 0.2s;
  }
  .revealed .panel.on .row {
    --delay: calc(var(--d0) + var(--i) * 50ms);
    opacity: 1;
    transform: none;
    transition:
      opacity 0.4s cubic-bezier(0.22, 1, 0.36, 1) var(--delay),
      transform 0.4s cubic-bezier(0.22, 1, 0.36, 1) var(--delay),
      background-color 0.2s;
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal,
    .row,
    .revealed .panel.on .row {
      transition: none;
      transform: none;
      opacity: 1;
    }
  }
</style>

<script>
  // Theme toggle
  document.getElementById('toggle')!.addEventListener('click', () => {
    document.documentElement.classList.toggle('dark');
    localStorage.setItem(
      'theme',
      document.documentElement.classList.contains('dark') ? 'dark' : 'light'
    );
  });

  // Block-cursor typer, with the staggered reveal running alongside it
  const el = document.getElementById('title')!;
  const text = el.textContent!;
  const card = document.getElementById('card')!;
  const main = card.parentElement!;
  let i = 0;

  function type() {
    if (i < text.length) {
      el.textContent += text[i++];
      setTimeout(type, 80 + Math.random() * 50);
    }
  }

  function reveal() {
    main.classList.add('revealed');
    // The first rows finish rising by about 1.2s; after that, tab switches show rows without the opening delay.
    setTimeout(() => main.classList.add('settled'), 1200);
  }

  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  el.classList.add('ready');
  if (reduced) {
    reveal();
  } else {
    el.textContent = '';
    setTimeout(() => {
      type();
      reveal();
    }, 500);
  }

  // Tabs: click, or arrow keys, Home and End once a tab has focus
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
  const panels = [...document.querySelectorAll<HTMLElement>('[role="tabpanel"]')];
  const indicator = document.getElementById('indicator')!;

  function select(n: number, focus = false) {
    tabs.forEach((tab, j) => {
      const on = j === n;
      tab.setAttribute('aria-selected', String(on));
      tab.tabIndex = on ? 0 : -1;
      panels[j].classList.toggle('on', on);
    });
    indicator.style.transform = `translateX(${n * 100}%)`;
    if (focus) tabs[n].focus();
  }

  tabs.forEach((tab, j) => {
    tab.addEventListener('click', () => select(j));
    tab.addEventListener('keydown', (e) => {
      const last = tabs.length - 1;
      const keys: Record<string, number> = { ArrowRight: j === last ? 0 : j + 1, ArrowLeft: j === 0 ? last : j - 1, Home: 0, End: last };
      if (!(e.key in keys)) return;
      e.preventDefault();
      select(keys[e.key], true);
    });
  });

  // Parallax tilt on the card (pointer devices, full motion only)
  if (!reduced && matchMedia('(hover: hover)').matches) {
    let tx = 0, ty = 0, cx = 0, cy = 0, raf = 0;

    function damp() {
      cx += (tx - cx) * 0.08;
      cy += (ty - cy) * 0.08;
      card.style.transform = `perspective(1000px) rotateX(${cy.toFixed(3)}deg) rotateY(${cx.toFixed(3)}deg)`;
      raf = Math.abs(tx - cx) + Math.abs(ty - cy) > 0.002 ? requestAnimationFrame(damp) : 0;
    }

    card.addEventListener('mousemove', (e) => {
      const r = card.getBoundingClientRect();
      tx = ((e.clientX - r.left) / r.width - 0.5) * 5;
      ty = -((e.clientY - r.top) / r.height - 0.5) * 5;
      if (!raf) raf = requestAnimationFrame(damp);
    });

    card.addEventListener('mouseleave', () => {
      tx = 0;
      ty = 0;
      if (!raf) raf = requestAnimationFrame(damp);
    });
  }
</script>
